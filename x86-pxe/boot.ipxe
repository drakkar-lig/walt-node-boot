#!ipxe

echo WALT -- IPXE STARTUP

# detect appropriate walt node model (64-bit CPU or not)
cpuid --ext 29 && set user-class walt.node.pc-x86-64 || set user-class walt.node.pc-x86-32

# check we have at least one network interface
isset ${net0/mac} || goto zerointerfaces

# loop over network interfaces and try to boot
set idx:int32 0
:loop
isset ${net${idx}/mac} || goto nomoreinterfaces
echo Trying to boot using net${idx}...
ifconf --configurator dhcp net${idx} || goto dhcpfailed
echo net${idx}: DHCP ok.
echo net${idx}: Trying to chainload tftp://${next-server}/start.ipxe
chain tftp://${next-server}/start.ipxe || goto chainfailed
echo Chainloaded script start.ipxe exited unexpectedly.
goto failed

:dhcpfailed
echo net${idx}: DHCP failed.
inc idx && goto loop

:chainfailed
echo net${idx}: Chainloading start.ipxe failed.
inc idx && goto loop

:zerointerfaces
echo No interface detected.
goto failed

:nomoreinterfaces
echo No more interfaces to try.
goto failed

:failed
echo Will reboot in 3s.
sleep 3
reboot
